# Testnet only. Never put a mainnet or funded personal mnemonic here.
# On a host, set these as environment variables instead; the server refuses to start without them.

# Q-Day Drill account (scripts/drill.ts)
DRILL_MNEMONIC="twenty four words"

# The server (server/index.ts)
OPERATOR_MNEMONIC="twenty four words"   # settler and relayer: creates, posts, opens, settles; funds test accounts
AGENT_MNEMONIC="twenty four words"      # the market maker's ML-DSA-87 key that signs every price curve
HEDGER_MNEMONIC="twenty four words"     # hedges on x/amm; also the treasury
STANDING_SEED="0x<32 bytes hex>"        # standing key for limit orders
AGENT_LINK_KEY="0x<32 bytes hex>"       # the agent's ed25519 key, linked to the operator with a spending rule (scripts/link-agent.ts)

# Unattended test runs (scripts/run-batches.ts)
USER1_MNEMONIC="twenty four words"
USER2_MNEMONIC="twenty four words"

# Optional
# DATA_DIR=data          where batch records and limit orders are kept
# INTAKE_MS=20000        how long a batch takes orders
